{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "edl",
      "camelcase": "Edl",
      "title": "EDL",
      "scope": "source.edl",
      "file-types": ["edl"],
      "injection-regex": "^edl$",
      "class-name": "TreeSitterEdl",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Enclave Definition Language (EDL) grammar for tree-sitter (Intel SGX SDK and Open Enclave)",
    "authors": [{ "name": "Marco Negro" }],
    "links": { "repository": "https://github.com/internaut401/tree-sitter-edl" }
  },
  "bindings": { "c": true, "go": true, "node": true, "python": true, "rust": true, "swift": true, "zig": false }
}
